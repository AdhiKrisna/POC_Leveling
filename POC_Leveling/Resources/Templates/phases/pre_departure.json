        "template": "{AIRPORT_NAME} Information {ATIS_ID}. Time {TIME_UTC} UTC. Runway {RUNWAY} in use. Wind {WIND_DIRECTION} degrees {WIND_SPEED} knots. Visibility {VISIBILITY}. Cloud {CLOUD_CONDITION}. Temperature {TEMPERATURE}, dew point {DEW_POINT}. QNH {QNH} hPa. On initial contact advise information {ATIS_ID} received.",
        "slots": ["AIRPORT_NAME","ATIS_ID","TIME_UTC","RUNWAY","WIND_DIRECTION","WIND_SPEED","VISIBILITY","CLOUD_CONDITION","TEMPERATURE","DEW_POINT","QNH"],
        "criticalReadback": []
