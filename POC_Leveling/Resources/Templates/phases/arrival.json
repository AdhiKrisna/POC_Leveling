    "phase": "ARRIVAL",
    "profile": ["IFR_COMMERCIAL", "VFR_LOCAL"],
    "initiator": "ATC",
    "exchanges": [
      {
        "turn": 1,
        "speaker": "ATC",
        "isUserTurn": false,
        "template": "{DESTINATION_NAME} Information {ARR_ATIS_ID}. Time {TIME_UTC} UTC. Arrival runway {ARR_RUNWAY}. Wind {WIND_DIRECTION} degrees {WIND_SPEED} knots. Visibility {VISIBILITY}. Temperature {TEMPERATURE}, dew point {DEW_POINT}. QNH {QNH} hPa.",
        "slots": ["DESTINATION_NAME","ARR_ATIS_ID","TIME_UTC","ARR_RUNWAY","WIND_DIRECTION","WIND_SPEED","VISIBILITY","TEMPERATURE","DEW_POINT","QNH"],
        "criticalReadback": []
      },
      {
        "turn": 2,
        "speaker": "PILOT",
        "isUserTurn": true,
        "template": "Information {ARR_ATIS_ID} received, QNH {QNH}, runway {ARR_RUNWAY}.",
        "slots": ["ARR_ATIS_ID","QNH","ARR_RUNWAY"],
        "criticalReadback": [
          { "slot": "ARR_ATIS_ID", "type": "mandatoryValue" },
          { "slot": "QNH", "type": "mandatoryNumber" },
          { "slot": "ARR_RUNWAY", "type": "mandatoryNumber" }
        ]
      }
    ],
    "_source": "ICAO Doc 9432 Ch.4 §4.7"
  },
